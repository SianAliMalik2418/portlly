{
  "name": "portlly",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:e2e": "vite dev --host 127.0.0.1 --port 3100",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "preprocess:smoke": "python3 scripts/preprocess/pipeline.py smoke",
    "preprocess:puzzles": "scripts/preprocess/.venv/bin/python scripts/preprocess/pipeline.py all",
    "preprocess:tickr": "python3 scripts/preprocess/tickr_pipeline.py all",
    "preprocess:tickr:smoke": "python3 scripts/preprocess/tickr_pipeline.py smoke",
    "e2e:setup": "bun run preprocess:smoke && PORTLLY_PUZZLE_DIST=dist/puzzles-smoke bun run r2:upload:local",
    "r2:create-bucket": "wrangler r2 bucket create portlly-puzzles",
    "r2:upload": "node scripts/r2/upload-puzzles.mjs",
    "r2:upload:local": "node scripts/r2/upload-puzzles.mjs --local",
    "r2:upload:tickr": "node scripts/r2/upload-tickr.mjs",
    "r2:upload:tickr:local": "node scripts/r2/upload-tickr.mjs --local"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@cloudflare/vite-plugin": "^1.40.2",
    "@playwright/test": "^1.60.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "jsdom": "^28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4",
    "wrangler": "^4.100.0"
  }
}

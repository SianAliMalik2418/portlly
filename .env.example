# Cloudflare values are introduced in the R2/deploy phases.
# Keep real secrets in .env.local or your Cloudflare environment, not in git.

# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# R2 upload (used by bun run r2:upload for remote S3-compatible uploads)
# Generate at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Cloudflare Web Analytics beacon. When set, the analytics snippet loads.
# Get the token: Cloudflare Dashboard → Analytics & Logs → Web Analytics →
# Add a site → copy the value of "token" from the provided snippet.
# VITE_CF_BEACON_TOKEN=
